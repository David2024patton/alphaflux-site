{
  "name": "alphaflux-site",
  "version": "1.0.0",
  "description": "AlphaFlux Marketing Agency - Full static website",
  "scripts": {
    "build": "npm run bundle-css && npx @11ty/eleventy",
    "bundle-css": "node scripts/build-css-bundle.js",
    "dev": "npx @11ty/eleventy --serve",
    "clean": "rm -rf _site",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "clean-css": "^5.3.0",
    "html-minifier": "^4.0.0",
    "terser": "^5.31.0"
  },
  "engines": {
    "node": ">=18"
  }
}
