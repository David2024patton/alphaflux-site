<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if schemaType %}{{ schemaType }}{% else %}WebPage{% endif %}",
  "name": "{{ title or site.name }}",
  "description": "{{ description or site.description }}",
  "url": "{{ site.url }}{{ page.url }}",
  "isPartOf": {
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "about": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "foundingDate": "2025",
    "areaServed": "Worldwide",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "availableLanguage": ["English"]
    }
  }
}
</script>
{% if faq and faq.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": "{{ item.question | safe }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.answer | safe }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
