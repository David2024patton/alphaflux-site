<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if schemaType %}{{ schemaType }}{% else %}WebPage{% endif %}",
  "name": "{% if title %}{{ title }} | {% endif %}{{ site.name }}",
  "description": "{{ description or site.description }}",
  "url": "{{ site.url }}{{ page.url }}",
  "isPartOf": {
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "about": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "foundingDate": "2025",
    "areaServed": "Worldwide",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "availableLanguage": ["English"]
    }
  }
}
</script>
