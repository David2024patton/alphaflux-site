<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">Alpha<span>Flux</span></div>
        <p class="footer-desc">AI-native digital growth agency. We combine cutting-edge artificial intelligence with deep human expertise to deliver superior marketing results.</p>
        <div class="footer-social">
          <a href="{{ site.social.linkedin }}" aria-label="LinkedIn" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="{{ site.social.twitter }}" aria-label="Twitter" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4 class="footer-heading">Services</h4>
        <ul class="footer-links">
          {% for item in site.footerServices %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Industries</h4>
        <ul class="footer-links">
          {% for item in site.footerIndustries %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Company</h4>
        <ul class="footer-links">
          {% for item in site.footerCompany %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          <li><a href="mailto:hello@alphaflux.net">hello@alphaflux.net</a></li>
          <li><a href="/contact/">Contact Form</a></li>
          <li><a href="/pricing/">Plans & Pricing</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 AlphaFlux. All rights reserved.</span>
      <span>AI-native digital growth.</span>
    </div>
  </div>
<div id="fluxchat-container"></div>
</footer>
