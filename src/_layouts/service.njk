---
layout: base.njk
---
{# Service detail page layout per design spec 4.2 #}
{% set serviceH1 = h1 or title %}
{% set servicePrice = price or "" %}
{% set serviceName = (title or serviceH1) | replace(" | AlphaFlux", "") %}
{% set breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: serviceName, url: page.url }
] %}

<section class="hero service-hero">
  <div class="hero-bg"></div>
  <div class="hero-glow"></div>
  <div class="container hero-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/services/">Services</a> <span aria-hidden="true">/</span> <span>{{ (title or serviceH1) | replace(' | AlphaFlux', '') }}</span>
    </nav>
    {% if moduleChips and moduleChips.length %}
    <div class="fluxos-chips">
      {% for chip in moduleChips %}<span class="fluxos-chip">{{ chip }}</span>{% endfor %}
    </div>
    {% endif %}
    <h1 class="display-lg">{{ serviceH1 }}</h1>
    {% if heroLead %}<p class="hero-desc">{{ heroLead }}</p>{% endif %}
    <p class="service-price-line">{% block priceLine %}{{ servicePrice }}{% endblock %}</p>
    <div class="cta-actions">
      <a href="/services/ai-geo/ai-visibility-audit/" class="btn btn-accent btn-lg">Get Free AI Visibility Audit</a>
      {% if servicePrice %}<a href="/pricing/" class="btn btn-secondary">See Published Pricing</a>{% endif %}
    </div>
  </div>
</section>

<section class="section proof-strip">
  <div class="container">
    <div class="proof-strip-content">
      <p class="proof-strip-text">Published pricing. Client-owned accounts. 90-day programs with itemized SOW.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container two-col">
    <div class="two-col-main">
      {{ content | safe }}
    </div>
    <aside class="two-col-side">
      <div class="sticky-cta-card">
        <h3>Start Your Program</h3>
        {% if servicePrice %}<p class="sticky-cta-price">{{ servicePrice }}</p>{% endif %}
        <a href="/services/ai-geo/ai-visibility-audit/" class="btn btn-accent btn-block">Get Free AI Visibility Audit</a>
        <p class="sticky-cta-response">Response within 24 hours</p>
      </div>
    </aside>
  </div>
</section>

{% block afterContent %}{% endblock %}

<section class="cta-section cta-audit">
  <div class="container">
    <h2 class="cta-title">See How Visible You Are in AI Search</h2>
    <p class="cta-desc">We audit your brand across Google, ChatGPT, Perplexity, and AI Overviews. Find out who answers for your brand right now, free.</p>
    <div class="cta-actions">
      <a href="/services/ai-geo/ai-visibility-audit/" class="btn btn-accent btn-lg">Get Your Free AI Visibility Audit</a>
      <a href="/pricing/" class="btn btn-secondary">See Published Pricing</a>
    </div>
  </div>
</section>
